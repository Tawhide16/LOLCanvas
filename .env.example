# =============================================================
# LOLCANVAS® ENVIRONMENT CONFIGURATION
# =============================================================

# App Environment
NODE_ENV=development
PORT=3000

# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION (POSTGRESQL / NEON / SUPABASE)
# -------------------------------------------------------------

# Option A: Local Docker PostgreSQL
# DATABASE_URL="postgresql://lolcanvas:lolcanvas_secret@localhost:5432/lolcanvas_db?schema=public"

# Option B: Neon Serverless PostgreSQL (https://neon.tech)
# Use the pooled connection for serverless/edge functions:
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/[dbname]?sslmode=require"
# Direct connection for Prisma migrations:
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].neon.tech/[dbname]?sslmode=require"

# Option C: Supabase PostgreSQL (https://supabase.com)
# Transaction pooler (port 6543) for serverless queries:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
# Direct connection (port 5432) for migrations:
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# -------------------------------------------------------------
# 2. SUPABASE INTEGRATION (STORAGE & AUTH)
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# -------------------------------------------------------------
# 3. JWT AUTHENTICATION
# -------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# -------------------------------------------------------------
# 4. REDIS CACHING & RATE LIMITING (UPSTASH)
# -------------------------------------------------------------
# (Optional: If omitted, LOLCanvas automatically uses high-performance in-memory cache)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# -------------------------------------------------------------
# 5. DOCKER COMPOSE DEFAULTS (OPTIONAL)
# -------------------------------------------------------------
POSTGRES_USER=lolcanvas
POSTGRES_PASSWORD=lolcanvas_secret
POSTGRES_DB=lolcanvas_db
POSTGRES_PORT=5432
